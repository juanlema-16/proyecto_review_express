PUERTO=3000
ENTORNO=desarrollo

# Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/
MONGO_BASE=proyecto_review

JWT_SECRETO=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRACION=2h
COOKIE_NOMBRE=review_token

# Versión que expone la API para la negociación con semver
API_VERSION=1.0.0

# Orígenes extra que pueden llamar a la API con credenciales, separados por coma.
# Vacío: solo el mismo origen, que es como la sirve este servidor.
ORIGENES_PERMITIDOS=

LIMITE_VENTANA_MINUTOS=15
LIMITE_GLOBAL=300
LIMITE_AUTENTICACION=10

# Administrador que crea la semilla
ADMIN_CORREO=admin@review.test
ADMIN_CONTRASENA=Admin1234
